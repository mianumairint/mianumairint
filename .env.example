# ─────────────────────────────────────────────────────────────
#  THE ONLY TWO VARIABLES THE APP NEEDS
#  Supabase dashboard → Settings → API
#
#  No connection string, no service-role key and no session
#  secret: Supabase Auth signs the sessions with the project's
#  own key, and row-level security decides what this key can
#  reach. Both values are safe in the browser.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase renamed this key from "anon" to "publishable". Either name works —
# set whichever one your dashboard shows.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─────────────────────────────────────────────────────────────
#  OPTIONAL — canonical URL used in sitemap.xml and robots.txt
#  Defaults to https://mianumairint.com
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://mianumairint.com


# ─────────────────────────────────────────────────────────────
#  OPTIONAL — Stripe. The card routes return a clear error
#  until both are set; cash-on-delivery orders work without them.
# ─────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
